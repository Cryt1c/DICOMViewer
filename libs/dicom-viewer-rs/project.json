{
  "name": "dicom-viewer-rs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "generators": {},
  "sourceRoot": "libs/dicom-viewer-rs/src",
  "prefix": "lib",
  "targets": {
    "build": {
      "command": "wasm-pack build libs/dicom-viewer-rs --out-dir ../../dist/dicom-viewer-rs --target web && node libs/dicom-viewer-rs/scripts/patch-worker-helpers.mjs"
    },
    "debug": {
      "command": "wasm-pack build --debug libs/dicom-viewer-rs --out-dir ../../dist/dicom-viewer-rs --target web && node libs/dicom-viewer-rs/scripts/patch-worker-helpers.mjs"
    },
    "serve": {
      "command": "nx watch --projects=dicom-viewer-rs -- nx run dicom-viewer-rs:debug"
    }
  }
}
